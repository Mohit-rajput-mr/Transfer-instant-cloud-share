{
  // Orbit's live updates (see src/index.ts). Deployed by Cloudflare Workers Builds from this folder on every push.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "transfer-instant-cloud-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // reachable at <name>.<account>.workers.dev (the site connects there)
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // the free plan runs SQLite-backed Durable Objects
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // downloads at the edge (src/index.ts file): the stored copies, read through Cloudflare's network
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "orbi-storage" }],
  "observability": { "enabled": true }
}
